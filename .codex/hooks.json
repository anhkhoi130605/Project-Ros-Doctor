{
  "description": "Write each Codex user prompt to the repository AI log.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/_pyrun.sh\" \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/_pyrun.cmd') (Join-Path (git rev-parse --show-toplevel) 'scripts/log_hook.py') --tool=codex\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}