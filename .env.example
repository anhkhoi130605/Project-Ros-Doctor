# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Direct OpenAI) ----
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=

# ---- Azure OpenAI Configuration (Alternative to avoid geographical blocks) ----
# AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-06-01

# Guardrails uses the server OPENAI_API_KEY or AZURE_OPENAI_*.
GUARDRAILS_ENABLED=true
# Optional; defaults to MODEL_NAME when omitted.
# GUARDRAILS_MODEL=gpt-4o-mini
GUARDRAILS_TIMEOUT_SECONDS=30
# Retry transient transport/429/5xx errors only, within the same total timeout.
GUARDRAILS_MAX_ATTEMPTS=2
GUARDRAILS_MAX_PROMPT_CHARS=128000
NEMO_GUARDRAILS_NO_USAGE_STATS=1
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Python needs its own MongoDB configuration; choose one option:
MONGO_CONNECTION_STRING=
MONGO_DATABASE_NAME=CtrlShiftN
# Local alternative: read MongoDbSettings from an explicitly selected .NET file.
# Leave MONGO_DATABASE_NAME unset to use the database name from that file.
# MONGO_SETTINGS_FILE="WebAPI/BackEnd(ASP.Net)/API/appsettings.Development.json"
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
RAG_CHUNK_UNIT=tokens
RAG_TOKEN_ENCODING=cl100k_base
RAG_SOURCE_NAMESPACE=ctrlshiftn
# Set RAG_EMBEDDING_MAX_TOKENS to the limit documented by your embedding provider.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=300
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
# Enable only after supplying a valid LangSmith key/project with write access.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- AI Code Review (GitLab CI & Local) ----
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_REVIEW_MAX_TOKENS=1500
GITLAB_TOKEN=your-gitlab-token-here
